# SPDX-FileCopyrightText: 2026 Choreoform contributors
# SPDX-License-Identifier: MPL-2.0
# Proposed authoring profile 0.2.0. See profile.md for lexical and semantic rules.
# Operators: sequence, | choice, () grouping, ? optional, * zero+, + one+.
# Quoted terminals are exact tokens. Uppercase terminals are lexical classes.
program = "Choreoform" "authoring" TEXT "." process ;
process = "Process" NAME "." interface declaration* "End" "process" "." ;
scope = "Scope" NAME "within" reference "." interface declaration* "End" "scope" "." ;
interface = "Start" "at" reference "." "Inputs" ports "." "Outputs" ports "." "Outcomes" names "." "Use" "cancellation" reference "," "faults" reference "," "closure" reference "and" "races" reference "." ;
declaration = scope | data | expression_declaration | actor | capability | policy | step ;
reference = NAME ("in" NAME)* ;
optional_reference = "none" | reference ;
names = "empty" | "[" NAME ("," NAME)* "]" ;
references = "empty" | "[" reference ("," reference)* "]" ;
ports = "empty" | "[" NAME "uses" reference ("," NAME "uses" reference)* "]" ;
data = "Keep" NAME "as" type "under" reference "." "Sensitivity" NAME "." "Purposes" names "." "Participants" references "." "Capabilities" references "." "Invalidate" references "." "Initially" ("unavailable" | "(" expression ")") "." "End" "data" "." ;
expression_declaration = "Let" NAME "mean" "(" expression ")" "as" type parameters "." ;
parameters = "with" "parameters" ("empty" | "[" NAME "as" type ("," NAME "as" type)* "]") ;
actor = "Require" "actor" NAME "under" reference "." ;
capability = "Use" "capability" NAME "from" reference "with" "input" type "and" "output" type "," "authority" reference "and" "effects" reference "." ;
step = "Step" NAME "." action ("Also" "read" references ".")? successor* "End" "step" "." ;
successor = "On" NAME "," "continue" "with" reference "." ;
action = human | request | compute | invoke | decision | split | join | wait | repeat | fanout | finish ;
result = "nothing" | reference ;
human = "Ask" reference "to" "decide" "using" reference "under" reference "and" "record" "in" result "." ;
request = "Request" reference "using" reference "under" reference "and" "record" "in" result "." ;
compute = "Set" "together" "[" assignment ("," assignment)* "]" "." ;
assignment = reference "to" "(" expression ")" ;
invoke = "Run" reference "with" "inputs" ports "and" "outputs" ports "." ;
decision = "Choose" "by" "[" NAME "when" reference ("," NAME "when" reference)* "]" ";" "otherwise" ("none" | NAME) "." ;
split = "Start" "together" "[" NAME "runs" reference ("," NAME "runs" reference)* "]" "and" "gather" "at" reference "." ;
join = "Gather" "from" reference "when" join_condition ";" "for" "unfinished" "work" "use" reference "." ;
outcome_reference = "outcome" NAME "of" reference ;
purpose_reference = "purpose" NAME "of" reference ;
outcome_set = "[" outcome_reference ("," outcome_reference)* "]" ;
join_condition = "all" "report" outcome_set | "any" "report" outcome_set | "at" "least" NAT "report" outcome_set | "both" "(" join_condition ")" "and" "(" join_condition ")" | "either" "(" join_condition ")" "or" "(" join_condition ")" ;
wait = "Wait" "under" reference "." ;
repeat = "While" reference "is" "true" "," "repeat" reference "." ;
fanout = "For" "each" "item" "of" reference "," "using" "key" reference "," "run" reference "with" "item" NAME ";" "seal" "when" reference "is" "true" ";" "for" "changes" "use" reference ";" "gather" "at" reference "." ;
finish = "Finish" "as" NAME "." ;
type = "truth" "value" | "text" | "whole" "number" | "decimal" "with" NAT "places" | "record" "with" type_fields | "choice" "with" "[" tag "as" type ("," tag "as" type)* "]" | "list" "of" type | "optional" type | "type" NAME "from" reference ;
type_fields = "empty" | "[" NAME "as" type ("," NAME "as" type)* "]" ;
tag = NAME | outcome_reference ;
expression = literal | read | parameter | fact | field | record | list | variant | absent | some | exists | present | case_name | payload | conditional | negation | binary | length | index | rescale | wrap | representation ;
literal = "true" | "false" | TEXT | INTEGER | "decimal" NUMBER "with" NAT "places" | outcome_reference | purpose_reference | "literal" "of" type "with" "value" value ;
value = "true" | "false" | TEXT | INTEGER | "decimal" NUMBER "with" NAT "places" | outcome_reference | purpose_reference | "record" "with" ("empty" | "[" NAME "is" "(" value ")" ("," NAME "is" "(" value ")")* "]") | "list" "containing" ("empty" | "[" "(" value ")" ("," "(" value ")")* "]") | "case" tag "containing" "(" value ")" | "absent" | "present" "(" value ")" ;
read = "the" "value" "of" reference ;
parameter = "the" "parameter" NAME ;
fact = "the" "fact" NAME ;
field = "field" NAME "of" "(" expression ")" ;
record = "record" "with" ("empty" | "[" NAME "is" "(" expression ")" ("," NAME "is" "(" expression ")")* "]") ;
list = "list" "of" type "containing" ("empty" | "[" "(" expression ")" ("," "(" expression ")")* "]") ;
variant = "case" tag "of" type "containing" "(" expression ")" ;
absent = "no" "value" "of" type ;
some = "some" "(" expression ")" ;
exists = "a" "value" "exists" "in" "(" expression ")" ;
present = "the" "present" "value" "of" "(" expression ")" ;
case_name = "the" "case" "of" "(" expression ")" ;
payload = "the" "payload" "of" "(" expression ")" "for" tag ;
conditional = "if" "(" expression ")" "then" "(" expression ")" "otherwise" "(" expression ")" ;
negation = "not" "(" expression ")" ;
binary = "(" expression ")" operator "(" expression ")" ;
operator = "and" | "or" | "equals" | "is" "less" "than" | "plus" | "minus" | "times" | "contains" ;
length = "the" "length" "of" "(" expression ")" ;
index = "item" "(" expression ")" "at" "index" "(" expression ")" ;
rescale = "(" expression ")" "expressed" "with" NAT "decimal" "places" ;
wrap = "(" expression ")" "as" "named" type ;
representation = "the" "representation" "of" "(" expression ")" ;
policy = actor_policy | protection_policy | capability_policy | effect_policy | work_policy | faults_policy | wait_policy | cancel_policy | settlement_policy | closure_policy | race_policy | membership_policy ;
actor_policy = "Rule" "for" "actor" NAME "." "Permit" "when" "(" expression ")" "." end_policy ;
protection_policy = "Rule" "for" "protection" NAME "." "Permit" "access" "when" "(" expression ")" "." end_policy ;
capability_policy = "Rule" "for" "capability" NAME "." "Provider" "contract" reference "." end_policy ;
effect_policy = "Rule" "for" "effect" NAME "." "Effect" "is" ("read-only" | "compensatable" | "irreversible") "." "Idempotency" "is" ("none" | "stable-key") "." "Reconcile" "under" reference "." end_policy ;
work_policy = "Rule" "for" "work" NAME "." "Instructions" NAME "." "Authority" reference "." "Attempts" NAT "." "Delays" delays "." "Retry" "faults" names "." "Timeout" timer "." "Complete" "when" "(" expression ")" "." "Compensates" optional_reference "." end_policy ;
delays = "empty" | "[" NAT "microseconds" ("," NAT "microseconds")* "]" ;
timer = "none" | "clock" reference "," "basis" reference "," "due" "(" expression ")" "," "calendar" optional_reference "," "pause" "authority" reference ;
faults_policy = "Rule" "for" "faults" NAME "." "Handle" ("empty" | "[" NAME "by" reference ("," NAME "by" reference)* "]") "." end_policy ;
wait_policy = "Rule" "for" "wait" NAME "." "Observe" type "." "Match" "when" "(" expression ")" "." "Authority" reference "." "Timer" timer "." "On" "observation" outcome_reference "." "On" "timer" ("none" | outcome_reference) "." end_policy ;
cancel_policy = "Rule" "for" "cancel" NAME "." "Authority" reference "." "For" "children" "use" reference "." end_policy ;
settlement_policy = "Rule" "for" "settlement" NAME "." "Unfinished" "work" ("retain" | "cancel" | "transfer" "to" reference) "." end_policy ;
closure_policy = "Rule" "for" "closure" NAME "." ("Fully" "terminal" "." | "Reconcile" "in" reference ".") end_policy ;
race_policy = "Rule" "for" "race" NAME "." ("Accept" "in" "acceptance" "order" "." | "Guard" "commits" "when" "(" expression ")" ".") end_policy ;
membership_policy = "Rule" "for" "membership" NAME "." "For" "removal" "use" reference "." "Changed" "items" "invalidate" "." end_policy ;
end_policy = "End" "policy" "." ;
