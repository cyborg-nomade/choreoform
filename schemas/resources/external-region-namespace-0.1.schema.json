{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:choreoform:schema:external-region-namespace:0.1.0",
  "title": "Standalone declared metadata; no definition or execution admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "profile",
    "authority",
    "keyTypes"
  ],
  "properties": {
    "kind": {
      "const": "external-region-namespace"
    },
    "version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile": {
      "$ref": "#/$defs/ref"
    },
    "authority": {
      "$ref": "#/$defs/ref"
    },
    "keyTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "text",
          "integer"
        ]
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
