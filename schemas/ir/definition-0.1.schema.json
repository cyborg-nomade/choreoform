        "entry": {
          "$ref": "#/$defs/id"
        },
        "outcomes": {
          "$ref": "#/$defs/nonemptySymbols"
        },
        "cancellation": {
          "$ref": "#/$defs/id"
        },
        "faults": {
          "$ref": "#/$defs/id"
        },
        "closure": {
          "$ref": "#/$defs/id"
