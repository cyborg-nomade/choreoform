        "participants": {
          "$ref": "#/$defs/symbols"
        },
        "capabilities": {
          "$ref": "#/$defs/symbols"
        },
        "policy": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "sensitivity",
        "purposes",
        "participants",
        "capabilities",
        "policy"
