      "const": "choreoform-ir"
    },
    "version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "definition"
    },
    "revision": {
      "$ref": "#/$defs/digest"
    },
    "body": {
      "$ref": "#/$defs/body"
