{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:choreoform:authoring:change:0.1.0",
  "title": "Atomic authoring change request 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "base",
    "operation"
  ],
  "properties": {
    "format": {
      "const": "choreoform-authoring-change"
    },
    "version": {
      "const": "0.1.0"
    },
    "base": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "format"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "rename"
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff\\u2028\\u2029]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "layout"
          ],
          "properties": {
            "kind": {
              "const": "replace-layout"
            },
            "layout": {
              "$ref": "urn:choreoform:authoring:layout:0.1.0"
            }
          }
        }
      ]
    }
  }
}
